# Copiar a .env.local y llenar con los valores reales del proyecto Supabase dedicado.
# Nunca commitear .env.local (ya está en .gitignore).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secreta — solo se usa en el servidor (seed y tareas administrativas). Nunca exponerla al cliente.
SUPABASE_SERVICE_ROLE_KEY=
